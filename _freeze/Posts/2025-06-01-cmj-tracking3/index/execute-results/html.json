,0,1)\",\"family\":\"\",\"size\":12.7521793275218},\"tickangle\":-0,\"showline\":false,\"linecolor\":null,\"linewidth\":0,\"showgrid\":true,\"gridcolor\":\"rgba(224,224,224,1)\",\"gridwidth\":0.66417600664176002,\"zeroline\":false,\"anchor\":\"x\",\"title\":{\"text\":\"<b> Jump Height (cm) <\\/b>\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":15.940224159402241}},\"hoverformat\":\".2f\"},\"shapes\":[{\"type\":\"rect\",\"fillcolor\":null,\"line\":{\"color\":null,\"width\":0,\"linetype\":[]},\"yref\":\"paper\",\"xref\":\"paper\",\"x0\":0,\"x1\":1,\"y0\":0,\"y1\":1}],\"showlegend\":false,\"legend\":{\"bgcolor\":\"rgba(255,255,255,1)\",\"bordercolor\":\"transparent\",\"borderwidth\":1.8897637795275593,\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":12.7521793275218}},\"hovermode\":\"closest\",\"barmode\":\"relative\"},\"config\":{\"doubleClick\":\"reset\",\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false,\"displaylogo\":false,\"modeBarButtonsToRemove\":[\"hoverCompare\",\"hoverclosest\",\"zoomIn2d\",\"zoomOut2d\",\"lasso2d\"]},\"source\":\"A\",\"attrs\":{\"7f15716d2eec\":{\"x\":{},\"text\":{},\"y\":{},\"type\":\"scatter\"},\"7f153723c221\":{\"x\":{},\"text\":{},\"y\":{}},\"7f15c9e20cf\":{\"x\":{},\"text\":{},\"y\":{}},\"7f15617bfc81\":{\"x\":{},\"text\":{},\"y\":{}},\"7f1512feab27\":{\"x\":{},\"text\":{},\"y\":{}},\"7f15d96972f\":{\"yintercept\":{}}},\"cur_data\":\"7f15716d2eec\",\"visdat\":{\"7f15716d2eec\":[\"function (y) \",\"x\"],\"7f153723c221\":[\"function (y) \",\"x\"],\"7f15c9e20cf\":[\"function (y) \",\"x\"],\"7f15617bfc81\":[\"function (y) \",\"x\"],\"7f1512feab27\":[\"function (y) \",\"x\"],\"7f15d96972f\":[\"function (y) \",\"x\"]},\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n\nInteractive Plot Showing Five Most Recent CMJ Assessments\n:::\n:::\n\n\n\n\nNow in Part 3, we will add some statistical analysis to our plot, in order to clearly see when jump performance has increased or decreased.\n\n------------------------------------------------------------------------\n\n# Overview\n\nThere are many options that we could use in order to determine if today's jump height is different from the previous day. In future blog posts I will explore different methods to determine statistically significant changes in performance, but today I will keep it simple by using only the Technical Error of Measurement (TEM).\n\nThe TEM is an estimate of the random measurement error in repeated observations. It allows us to determine whether the difference between observations is likely to be real (i.e. a potential change in neuromuscular status) or due to random measurement error.\n\nIt should be noted that the TEM does not detect real differences. At this point we are only checking to see if the difference is **potentially** real.\n\nHere are the steps we will walk through in this post:\n\n1.  Calculate TEM using a new data set containing all of the historical jump data for this particular athlete.\n2.  Determine when the difference between daily performances is above or below the TEM.\n3.  Add a symbol to our interactive plot to indicate potentially real changes in jump height.\n\n# 1. Calculate TEM\n\nFirstly, we will need a larger dataset in order to more accurately calculate TEM\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\n#\nathlete1 <- read_csv(\"athlete1.csv\") %>%\n  mutate(date_mmmddyear = format(Date, \"%b %d, %Y\"))\n```\n\n::: {.cell-output .cell-output-stderr}\n\n```\nRows: 102 Columns: 3\n── Column specification ────────────────────────────────────────────────────────\nDelimiter: \",\"\nchr  (1): Jump\ndbl  (1): flight_height_tov\ndate (1): Date\n\nℹ Use `spec()` to retrieve the full column specification for this data.\nℹ Specify the column types or set `show_col_types = FALSE` to quiet this message.\n```\n\n\n:::\n:::\n\n\n\n\nThree Steps\n\n1.  Create a new dataframe which returns a mean jump height for each day and also the difference in jump height between consecutive days.\n\n2.  Use the computed differences to calculate TEM\n\n3.  Create a column which returns a specific value when the difference in jump scores between consecutive days is greater than the TEM.\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\n#Create a mean score for each datae\nTEM_df <- recent_five %>%\n    group_by(Date) %>% #<1>\n    dplyr::summarise(mean = mean(flight_height_tov)) %>%\n    mutate(diff = c(0,diff(mean)))\n\n  TEM <- sqrt((sum(TEM_df$diff)^2) / (2 * nrow(TEM_df)))\n  \n  TEM_df <- TEM_df %>%\n    mutate(real = ifelse(abs(diff) > TEM, \"*\", NA))\n```\n:::\n\n\n\n\n# 2. Adding the Layer\n",
